# Site
NEXT_PUBLIC_SITE_URL=https://ergoblockchain.org
NEXT_PUBLIC_TWITTER_HANDLE=@BuildOnErgo

# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Algolia Search
NEXT_PUBLIC_ALGOLIA_APP_ID=your-app-id
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=your-search-api-key
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=ergo-docs

# Newsletter (Beehiiv)
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Crowdin (translations)
CROWDIN_PROJECT_ID=
CROWDIN_TOKEN=

# CDN (optional)
NEXT_PUBLIC_CDN_URL=https://cdn.ergoblockchain.org
NEXT_PUBLIC_USE_CDN=false

# Monitoring (optional)
NEXT_PUBLIC_METRICS_ENDPOINT=
NEXT_PUBLIC_ALERT_WEBHOOK=

# Sage chat (Phase 1 — required)
ANTHROPIC_API_KEY=

# Sage payments (Phase 2 — required to unlock premium-query gating)
# Sage's testnet receiver address (9f… for testnet, 9... for mainnet).
SAGE_WALLET_ADDRESS=
# Reserve box id Sage redeems Notes against (one-time setup, see docs).
SAGE_RESERVE_BOX_ID=
# HMAC key for short-lived payment tokens after Note verification.
# Generate with: openssl rand -hex 32
SAGE_PAYMENT_HMAC_KEY=
# 'testnet' (default) or 'mainnet'.
SAGE_NETWORK=testnet
# Sage signer:
#   Set SAGE_SIGNER_URL to POST unsigned txs to standalone scripts/sage-signer/,
#   a KMS, or an HSM. If unset, Sage runs in verify-only mode. Keep
#   SAGE_WALLET_SEED in scripts/sage-signer/.env, not in the Next.js deployment.
#   Without either, Sage runs in verify-only mode (premium answers flow,
#   redemption deferred). See scripts/sage-signer/README.md for the recommended
#   setup.
SAGE_SIGNER_URL=
SAGE_SIGNER_TOKEN=
# Optional public Ergo node for redemption tx submission.
SAGE_NODE_URL=
# Durable full receipt bundle storage (Vercel Blob).
# Required for /api/sage/receipt/<id> to return Agreement JSON,
# Verification Receipt JSON, and Settlement Receipt JSON after payment.
BLOB_READ_WRITE_TOKEN=
