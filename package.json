{
  "name": "ergo-blockchain",
  "engines": {
    "node": "22.x"
  },
  "version": "0.1.5",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-version.js && node scripts/build-sage-index.mjs && node scripts/sync-monaco.mjs && npx next dev",
    "build": "node scripts/generate-version.js && node scripts/build-icons.mjs && node scripts/build-sage-index.mjs && node scripts/sync-monaco.mjs && NODE_OPTIONS=--max-old-space-size=4096 npx next build --webpack",
    "preflight:batch": "node scripts/final-batch-preflight.mjs",
    "sage:index": "node scripts/build-sage-index.mjs",
    "sage:wallet": "npm --prefix scripts/sage-signer install && npm --prefix scripts/sage-signer run bootstrap",
    "sage:wallet:balance": "npm --prefix scripts/sage-signer install && npm --prefix scripts/sage-signer run balance",
    "sage:wallet:reserve": "npm --prefix scripts/sage-signer install && npm --prefix scripts/sage-signer run reserve",
    "sage:wallet:issue-note": "npm --prefix scripts/sage-signer install && npm --prefix scripts/sage-signer run issue-note",
    "sage:signer": "npm --prefix scripts/sage-signer install && npm --prefix scripts/sage-signer start",
    "sage:conformance": "node scripts/sage-conformance.mjs",
    "sage:conformance:evidence": "node scripts/sage-conformance.mjs --registry-out artifacts/sage-conformance/latest-evidence.json",
    "sage:proof-reconcile": "node scripts/sage-proof-reconcile.mjs",
    "icons": "node scripts/build-icons.mjs",
    "start": "npx next start",
    "lint": "eslint",
    "analyze": "ANALYZE=true npx next build",
    "type-check": "node scripts/strip-next-dev-types.mjs && tsc --noEmit",
    "lint:fix": "npx next lint --fix",
    "clean": "rm -rf .next node_modules package-lock.json",
    "audit:deps": "npx depcheck",
    "audit:bundle": "npx @next/bundle-analyzer",
    "optimize:og": "node scripts/optimize-og-assets.mjs",
    "audit:assets": "node scripts/audit-heavy-assets.mjs",
    "vercel:prune-assets": "node scripts/prune-vercel-output-assets.mjs",
    "lighthouse": "lhci autorun",
    "lighthouse:mobile": "lhci autorun --collect.settings.preset=mobile",
    "lighthouse:desktop": "lhci autorun --collect.settings.preset=desktop",
    "perf:test": "npm run build && npm run lighthouse",
    "perf:analyze": "ANALYZE=true npx next build",
    "i18n:analyze": "node scripts/analyze-i18n.js",
    "i18n:upload": "node scripts/lokalise-cli.js upload",
    "i18n:download": "node scripts/lokalise-cli.js download",
    "i18n:sync": "node scripts/lokalise-cli.js sync",
    "i18n:status": "node scripts/lokalise-cli.js status",
    "i18n:qa": "node scripts/lokalise-cli.js qa",
    "i18n:install": "node scripts/lokalise-cli.js install",
    "build:search": "node scripts/build-search-index.js",
    "search:index": "npm run build:search && echo 'Search index built successfully'",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "health": "node scripts/health-check.js",
    "health:prod": "BASE_URL=https://www.ergoblockchain.org node scripts/health-check.js",
    "watch:post-deploy": "node scripts/post-deploy-watch.mjs",
    "watch:agent-economy": "npm run watch:post-deploy && npm run sage:proof-reconcile",
    "smoke:routes": "node scripts/route-smoke.mjs",
    "smoke:routes:prod": "BASE_URL=https://www.ergoblockchain.org node scripts/route-smoke.mjs",
    "smoke:staging": "node scripts/staging-smoke.mjs",
    "check:clickthrough": "node scripts/check-clickthrough.mjs",
    "qa:mobile-crawl": "node scripts/mobile-crawl.mjs",
    "qa:sitemap-crawl": "node scripts/mobile-crawl.mjs --status-only",
    "audit:blog": "node scripts/blog-content-audit.mjs",
    "audit:claims": "node scripts/content-claim-audit.mjs",
    "audit:agent-host": "node scripts/agent-host-routes-audit.mjs",
    "audit:agent-economy-gate": "node scripts/agent-economy-gate-audit.mjs",
    "audit:locales": "node scripts/localization-audit.mjs",
    "translate": "node scripts/translate-json.js",
    "translate:ru": "node scripts/translate-json.js --all ru",
    "translate:zh": "node scripts/translate-json.js --all zh-cn",
    "crowdin:upload": "crowdin upload sources",
    "crowdin:download": "crowdin download"
  },
  "dependencies": {
    "@accord-protocol/core": "^0.4.2",
    "@accord-protocol/gateway": "^0.4.0",
    "@accord-protocol/mcp": "^0.4.0",
    "@accord-protocol/rails": "^0.4.0",
    "@accord-protocol/rails-ergo": "^0.4.0",
    "@algolia/autocomplete-core": "^1.19.2",
    "@algolia/autocomplete-plugin-algolia-insights": "^1.19.2",
    "@algolia/autocomplete-plugin-query-suggestions": "^1.19.2",
    "@anthropic-ai/sdk": "^0.96.0",
    "@emotion/is-prop-valid": "^1.2.2",
    "@fleet-sdk/compiler": "^0.12.0",
    "@fleet-sdk/core": "^0.12.0",
    "@monaco-editor/react": "^4.7.0",
    "@next/mdx": "16.0.1",
    "@noble/curves": "^1.9.7",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-collapsible": "^1.0.3",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.1.4",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.1.12",
    "@vercel/blob": "^2.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ergo-agent-pay": "^0.3.0",
    "ergo-lib-wasm-browser": "^0.28.0",
    "express": "^5.1.0",
    "framer-motion": "^12.23.24",
    "glob": "^10.4.5",
    "gray-matter": "^4.0.3",
    "jsonpath-plus": "^10.3.0",
    "katex": "^0.16.22",
    "lucide-react": "^0.454.0",
    "mermaid": "^11.10.1",
    "monaco-editor": "^0.55.1",
    "next": "^16.0.10",
    "next-intl": "^4.3.12",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "prom-client": "^15.1.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-katex": "^3.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "web-vitals": "^5.1.0"
  },
  "overrides": {
    "dompurify": "^3.2.4",
    "lodash.set": "^4.3.2",
    "lodash": "^4.17.21",
    "jsonpath-plus": "^10.3.0",
    "micromatch": "^4.0.8",
    "postcss": "^8.5.14",
    "qs": "^6.15.2"
  },
  "devDependencies": {
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@playwright/test": "^1.40.1",
    "@types/node": "^22",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/react-katex": "^3.0.4",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "axe-playwright": "^2.0.1",
    "critters": "^0.0.23",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.3.0",
    "typescript": "5.9.3"
  }
}
