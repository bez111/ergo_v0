  {
    "key": "hodlers.holdersPage.faq.questions.0.question",
    "source": "What makes ERG different from Bitcoin?",
    "context": "FAQ content",
    "maxLength": 57,
    "translation": ""
  },
  {
    "key": "hodlers.holdersPage.faq.questions.0.answer",
    "source": "ERG extends Bitcoin's security model with smart contracts, optional privacy, and storage rent for long-term sustainability. Same PoW security, more functionality.",
    "context": "FAQ content",
    "maxLength": 243,
    "translation": ""
  },
  {
    "key": "hodlers.holdersPage.faq.questions.1.question",
    "source": "Is ERG a good long-term investment?",
    "context": "FAQ content",
    "maxLength": 52.5,
    "translation": ""
  },
  {
    "key": "hodlers.holdersPage.faq.questions.1.answer",
    "source": "ERG has strong fundamentals: fixed supply, fair launch, real utility through DeFi. Always DYOR and never invest more than you can afford to lose.",
    "context": "FAQ content",
    "maxLength": 217.5,
    "translation": ""
  },
  {
    "key": "hodlers.holdersPage.faq.questions.2.question",
    "source": "How do I store ERG safely?",
    "context": "FAQ content",
    "maxLength": 39,
    "translation": ""
  },
  {
    "key": "hodlers.holdersPage.faq.questions.2.answer",
    "source": "Use Nautilus wallet for convenience or Ledger hardware wallet for maximum security. Never share your seed phrase.",
    "context": "FAQ content",
    "maxLength": 169.5,
    "translation": ""
  },
  {
    "key": "hodlers.holdersPage.faq.questions.3.question",
    "source": "Can I earn yield on my ERG?",
    "context": "FAQ content",
    "maxLength": 40.5,
    "translation": ""
  },
  {
    "key": "hodlers.holdersPage.faq.questions.3.answer",
    "source": "Yes, but verify current protocol status first. Spectrum Finance is a historical Ergo DEX reference with a 2024 sunset notice, ErgoPad is not currently operating, and DeFi positions remain funds-at-risk software.",
    "context": "FAQ content",
    "maxLength": 316.5,
    "translation": ""
  },
  {
    "key": "hodlers.holdersPage.faq.questions.4.question",
    "source": "Is Ergo a security or commodity?",
    "context": "FAQ content",
    "maxLength": 48,
    "translation": ""
  },
  {
    "key": "hodlers.holdersPage.faq.questions.4.answer",
    "source": "Ergo launched fairly in 2019 with no premine, no ICO, and no VC funding. Like Bitcoin, it's a decentralized, community-driven project. The fair launch and Proof-of-Work consensus make it similar to Bitcoin from a regulatory perspective.",
    "context": "FAQ content",
    "maxLength": 354,
    "translation": ""
  },
  {
    "key": "hodlers.holdersPage.faq.questions.5.question",
    "source": "Who controls the Ergo project?",
    "context": "FAQ content",
    "maxLength": 45,
    "translation": ""
  },
  {
    "key": "hodlers.holdersPage.faq.questions.5.answer",
    "source": "No single entity controls Ergo. It's maintained by the Ergo Foundation, core developers, and community contributors. All development is open-source on GitHub. The community votes on major protocol changes.",
    "context": "FAQ content",
    "maxLength": 307.5,
    "translation": ""
  },
  {
    "key": "hodlers.holdersPage.faq.questions.6.question",
    "source": "What happens when mining rewards end?",
    "context": "FAQ content",
    "maxLength": 55.5,
    "translation": ""
  },
  {
    "key": "hodlers.holdersPage.faq.questions.6.answer",
    "source": "Ergo has an 8-year emission schedule ending around 2027. After that, miners are incentivized by transaction fees and a storage rent mechanism that recycles lost coins. This creates sustainable long-term security without inflation.",
    "context": "FAQ content",
    "maxLength": 345,
    "translation": ""
  },
  {
    "key": "hodlers.holdersPage.faq.questions.7.question",
    "source": "Where can I buy and store ERG?",
    "context": "FAQ content",
    "maxLength": 45,
    "translation": ""
  },
  {
    "key": "hodlers.holdersPage.faq.questions.7.answer",
    "source": "ERG is available on major exchanges like KuCoin, Gate.io, and CoinEx. For storage, use Nautilus Wallet or hardware wallets. See our complete buying guide at /use/get-erg.",
    "context": "FAQ content",
    "maxLength": 255,
    "translation": ""
  },
  {
    "key": "hodlers.holdersPage.faq.questions.8.question",
    "source": "Is Ergo's privacy legal to use?",
    "context": "FAQ content",
    "maxLength": 46.5,
    "translation": ""
  },
  {
    "key": "hodlers.holdersPage.faq.questions.8.answer",
    "source": "Ergo privacy is optional and can support selective-disclosure workflows. Actual legal compliance depends on jurisdiction, implementation, and the surrounding service provider.",
