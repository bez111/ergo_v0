  {
    "key": "wallet.wallet.faq.items.0.question",
    "source": "What is the best Ergo wallet?",
    "context": "FAQ content",
    "maxLength": 43.5,
    "translation": ""
  },
  {
    "key": "wallet.wallet.faq.items.0.answer",
    "source": "The best Ergo wallet depends on your needs: Nautilus (browser extension) is great for DeFi and dApp interactions, Ergo Mobile Wallet is ideal for everyday phone use, and SAFEW offers advanced features for power users. For maximum security, use a Ledger hardware wallet with Nautilus.",
    "context": "FAQ content",
    "maxLength": 424.5,
    "translation": ""
  },
  {
    "key": "wallet.wallet.faq.items.1.question",
    "source": "Is Nautilus wallet safe?",
    "context": "FAQ content",
    "maxLength": 36,
    "translation": ""
  },
  {
    "key": "wallet.wallet.faq.items.1.answer",
    "source": "Nautilus is a secure non-custodial wallet. Your keys are stored locally and encrypted, and the project is open-source. Always back up your 15-word seed phrase securely—if you lose it, you lose access to your funds.",
    "context": "FAQ content",
    "maxLength": 321,
    "translation": ""
  },
  {
    "key": "wallet.wallet.faq.items.2.question",
    "source": "Can I use Ledger with Ergo?",
    "context": "FAQ content",
    "maxLength": 40.5,
    "translation": ""
  },
  {
    "key": "wallet.wallet.faq.items.2.answer",
    "source": "Yes. Ergo is supported on Ledger hardware wallets. Using Ledger with Nautilus keeps your private keys on the device and is a strong option for long-term storage.",
    "context": "FAQ content",
    "maxLength": 241.5,
    "translation": ""
  },
  {
    "key": "wallet.wallet.faq.items.3.question",
    "source": "How do I back up my Ergo wallet?",
    "context": "FAQ content",
    "maxLength": 48,
    "translation": ""
  },
  {
    "key": "wallet.wallet.faq.items.3.answer",
    "source": "When you create a wallet you receive a 15-word seed phrase. Write it down on paper (never store it digitally) and keep it in multiple safe locations. Never share it—anyone with the phrase controls your funds.",
    "context": "FAQ content",
    "maxLength": 312,
    "translation": ""
  },
  {
    "key": "wallet.wallet.faq.items.4.question",
    "source": "Which wallet supports Ergo NFTs?",
    "context": "FAQ content",
    "maxLength": 48,
    "translation": ""
  },
  {
    "key": "wallet.wallet.faq.items.4.answer",
    "source": "Nautilus is a popular choice for Ergo NFTs thanks to marketplace integrations (e.g. SkyHarbor). SAFEW also supports NFTs with an advanced token viewer.",
    "context": "FAQ content",
    "maxLength": 226.5,
    "translation": ""
  },
