  {
    "key": "agent-economy.agentEconomy.problem.sectionLabel",
    "source": "The Problem",
    "context": "General content",
    "maxLength": 16.5,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.problem.heading",
    "source": "Merchant checkout rails solve commerce.",
    "context": "General content",
    "maxLength": 58.5,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.problem.headingMuted",
    "source": "Autonomous work settlement needs another layer.",
    "context": "General content",
    "maxLength": 70.5,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.stripeProblemItems.0.title",
    "source": "No persistent identity",
    "context": "Title",
    "maxLength": 33,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.stripeProblemItems.0.body",
    "source": "Commerce rails are built around persistent buyers, merchants, accounts, disputes and compliance. Autonomous work flows can be temporary processes acting under bounded authority.",
    "context": "General content",
    "maxLength": 265.5,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.stripeProblemItems.1.title",
    "source": "One-time payments only",
    "context": "Title",
    "maxLength": 33,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.stripeProblemItems.1.body",
    "source": "Autonomous services often need bounded credit: issue now, redeem later, expire by policy. That is a settlement primitive, not only a checkout event.",
    "context": "General content",
    "maxLength": 222,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.stripeProblemItems.2.title",
    "source": "No programmable acceptance",
    "context": "Title",
    "maxLength": 39,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.stripeProblemItems.2.body",
    "source": "A work rail needs terms inside the claim: accept only if the task hash, verifier receipt, deadline and policy match. Otherwise payment and verification split apart.",
    "context": "General content",
    "maxLength": 246,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.stripeProblemItems.3.title",
    "source": "Millisecond economics break",
    "context": "Title",
    "maxLength": 40.5,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.stripeProblemItems.3.body",
    "source": "Small machine calls need deterministic costs and receipt retention. Human checkout systems can coexist with this, but they do not replace the programmable settlement layer.",
    "context": "General content",
    "maxLength": 258,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.creditUnlock.sectionLabel",
    "source": "The Unlock",
    "context": "General content",
    "maxLength": 15,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.creditUnlock.heading",
    "source": "Verifiable workflows are table stakes. Programmable credit is the unlock.",
    "context": "General content",
    "maxLength": 109.5,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.creditUnlock.description",
    "source": "A verifiable workflow proves that work happened. Programmable credit lets agents coordinate future work before final settlement: sub-agent budgets, task-conditioned Notes, reserve-backed claims, expiry rules and policy-constrained spending.",
    "context": "Description",
    "maxLength": 360,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.creditUnlock.formula",
    "source": "Payments move value. Verification proves work. Credit creates economic agency.",
    "context": "General content",
    "maxLength": 117,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.creditUnlock.items.0.title",
    "source": "Payments",
    "context": "Title",
    "maxLength": 12,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.creditUnlock.items.0.body",
    "source": "Agents pay for API calls, compute, data and tools without forcing every decision back through a human checkout.",
    "context": "General content",
    "maxLength": 166.5,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.creditUnlock.items.1.title",
    "source": "Verification",
    "context": "Title",
    "maxLength": 18,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.creditUnlock.items.1.body",
    "source": "Receipts, task hashes and acceptance predicates define whether the agreed work actually happened.",
    "context": "General content",
    "maxLength": 145.5,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.creditUnlock.items.2.title",
    "source": "Credit",
    "context": "Title",
    "maxLength": 9,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.creditUnlock.items.2.body",
    "source": "Bounded, redeemable Notes let agents coordinate work now and settle later under explicit rules.",
    "context": "General content",
    "maxLength": 142.5,
    "translation": ""
  },
