  },
  {
    "key": "agent-economy.agentEconomy.whyErgoItems.0.title",
    "source": "eUTXO: verifiable atomicity",
    "context": "Title",
    "maxLength": 40.5,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.whyErgoItems.0.body",
    "source": "Transactions are deterministic against explicit inputs and outputs. Agents can reason about outcomes before submitting, with no protocol-level reentrancy and less exposure to common account-model MEV patterns.",
    "context": "General content",
    "maxLength": 313.5,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.whyErgoItems.0.href",
    "source": "/technology/eutxo-model",
    "context": "General content",
    "maxLength": 34.5,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.whyErgoItems.1.title",
    "source": "ErgoScript: programmable trust",
    "context": "Title",
    "maxLength": 45,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.whyErgoItems.1.body",
    "source": "Acceptance predicates are first-class primitives. 'Accept this note only if task hash matches and deadline hasn't passed' — one script, on-chain, trustless.",
    "context": "General content",
    "maxLength": 234,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.whyErgoItems.1.href",
    "source": "/technology/ergoscript",
    "context": "General content",
    "maxLength": 33,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.whyErgoItems.2.title",
    "source": "Babel Fees: agents don't need ERG",
    "context": "Title",
    "maxLength": 49.5,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.whyErgoItems.2.body",
    "source": "Agents can cover transaction fees through supported token-to-ERG paths. That reduces the need to pre-fund every new agent instance with ERG — critical for ephemeral compute.",
    "context": "General content",
    "maxLength": 259.5,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.whyErgoItems.2.href",
    "source": "/technology/babel-fees",
    "context": "General content",
    "maxLength": 33,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.whyErgoItems.3.title",
    "source": "Sigma Protocols: private credit",
    "context": "Title",
    "maxLength": 46.5,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.whyErgoItems.3.body",
    "source": "Zero-knowledge proofs are native. Agents can prove they hold a credential or completed a task without revealing which agent they are.",
    "context": "General content",
    "maxLength": 199.5,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.whyErgoItems.3.href",
    "source": "/technology/privacy-features",
    "context": "General content",
    "maxLength": 42,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.whyErgoItems.4.title",
    "source": "Proof-of-Work: no chain halts",
    "context": "Title",
    "maxLength": 43.5,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.whyErgoItems.4.body",
    "source": "PoW has no governance emergency stops. Agent infrastructure built on Ergo won't be frozen by a validator cartel or foundation decision.",
    "context": "General content",
    "maxLength": 202.5,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.whyErgoItems.4.href",
    "source": "/technology",
    "context": "General content",
    "maxLength": 16.5,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.whyErgoItems.5.title",
    "source": "Native tokens: community money",
    "context": "Title",
    "maxLength": 45,
    "translation": ""
  },
  {
    "key": "agent-economy.agentEconomy.whyErgoItems.5.body",
    "source": "Issue native tokens and design Note/Reserve-style payment patterns without ERC-20-style deployment ceremony. Specific agent-payment contracts remain prototype/testnet-first unless audited.",
    "context": "General content",
    "maxLength": 282,
    "translation": ""
  },
