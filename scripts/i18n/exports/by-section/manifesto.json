  {
    "key": "manifesto.manifesto.content.paragraph1",
    "source": "In a world of increasing surveillance and control, we stand for financial freedom and privacy.",
    "context": "General content",
    "maxLength": 141,
    "translation": ""
  },
  {
    "key": "manifesto.manifesto.content.paragraph2",
    "source": "Ergo is built on the core principles that drove the original crypto revolution: open, permissionless, secure systems that empower regular people.",
    "context": "General content",
    "maxLength": 217.5,
    "translation": ""
  },
  {
    "key": "manifesto.manifesto.content.paragraph3",
    "source": "We reject the centralization of power. We reject the surveillance state. We reject the corporate capture of our financial systems.",
    "context": "General content",
    "maxLength": 195,
    "translation": ""
  },
  {
    "key": "manifesto.manifesto.content.paragraph4",
    "source": "Ergo provides the tools for people to secure their financial interactions through contractual money - programmable, private, and unstoppable.",
    "context": "General content",
    "maxLength": 211.5,
    "translation": ""
  },
  {
    "key": "manifesto.manifesto.content.conclusion",
    "source": "This is not just technology. This is resistance.",
    "context": "General content",
    "maxLength": 72,
    "translation": ""
