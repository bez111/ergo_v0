# Sage signer — local HTTP signing service. See README.md for setup.

# BIP-39 mnemonic for the Sage seller wallet. Same wallet whose address
# is set as SAGE_WALLET_ADDRESS on Vercel.
# Generate via Nautilus → Settings → Recovery phrase, OR via:
#   npx @fleet-sdk/wallet-secret generate-mnemonic
SAGE_WALLET_SEED=

# Optional BIP-39 passphrase. Leave empty for the standard derivation.
SAGE_WALLET_PASSPHRASE=

# Network: 'testnet' (default) or 'mainnet'. Don't run mainnet via this
# scaffold — see "Hardening" in README before you do.
SAGE_NETWORK=testnet

# HTTP port. Default 8911. Make sure it's free.
PORT=8911

# Health probe base URL for `npm run health`. Defaults to localhost:$PORT.
SAGE_SIGNER_HEALTH_URL=http://127.0.0.1:8911

# Bearer token Vercel must include in Authorization header. Generate via:
#   openssl rand -hex 32
# Then set the SAME value as SAGE_SIGNER_TOKEN in Vercel env.
SAGE_SIGNER_TOKEN=

# Policy guardrails — refuse txs that exceed these.
SAGE_MAX_SINGLE_TX_NANOERG=10000000     # 0.01 ERG default
SAGE_SIGNER_MAX_BODY_BYTES=262144       # 256 KiB default

# Comma-separated whitelist of recipient addresses the signer will allow.
# Empty disables the whitelist (NOT recommended for mainnet).
SAGE_WHITELIST_ADDRS=
