From af2160dc244c09b6b2c6a37a6b30d9a3859cfcf6 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=E2=80=9Cbez=E2=80=9D?= <alexander.bezkrovny@gmail.com>
Date: Fri, 15 May 2026 13:16:40 -0300
Subject: [PATCH] registry: bump Sage to full-redemption with live_proof
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Sage's Phase 2 closed end-to-end on 2026-05-15: signer wired, first
on-chain redemption tx confirmed at testnet block 345673. Bump the
provider profile so consumers (other agents, conformance runners,
discovery dashboards) can verify rail health from a single read:

- operational_status.settlement_mode → "full-redemption" with the
  block height of the first settled tx
- new live_proof block: settlement tx hash, ISO timestamp, explorer
  URL, public receipt URL, live activity feed endpoint
- new endpoints.live_activity entry pointing at the same feed
- conformance.notes records manual verification 2026-05-15; automated
  run still pending behind accord-conformance v0
---
 registry/providers/sage.json | 16 +++++++++++++---
 1 file changed, 13 insertions(+), 3 deletions(-)

diff --git a/registry/providers/sage.json b/registry/providers/sage.json
index 388e95c..e0511b0 100644
--- a/registry/providers/sage.json
+++ b/registry/providers/sage.json
@@ -29,7 +29,8 @@
     "agreement_template": "https://www.ergoblockchain.org/api/sage/quote",
     "chat": "https://www.ergoblockchain.org/api/sage/chat",
     "verify_payment": "https://www.ergoblockchain.org/api/sage/verify-payment",
-    "receipt_pattern": "https://www.ergoblockchain.org/r/sage/{settlement_or_note_box_id}"
+    "receipt_pattern": "https://www.ergoblockchain.org/r/sage/{settlement_or_note_box_id}",
+    "live_activity": "https://www.ergoblockchain.org/api/sage/activity"
   },
   "implementation": {
     "reference_example": "https://github.com/accord-protocol/accord-protocol/tree/main/examples/16-paid-mcp-ergo-testnet",
@@ -39,13 +40,22 @@
     "phase": "phase-2-testnet",
     "tier_routing": "free | premium",
     "premium_premise": "questions flagged by gate.ts (explicit /command, code-request hints, deep-research phrasing, >400 chars, multi-turn follow-up) require an Accord Note before Sonnet 4.6 routing",
-    "settlement_mode": "verify-only by default; full redemption when SAGE_SIGNER_URL is configured (see scripts/sage-signer/ in ergoblockchain.org repo)"
+    "settlement_mode": "full-redemption — seller signer is wired and live. The first end-to-end settled redemption tx confirmed at testnet block 345673 on 2026-05-15."
+  },
+  "live_proof": {
+    "first_settlement_tx": "f697e4841dd9a0c689d0b83a311130b85a0cfbab123230a6c40284b44c4cafef",
+    "first_settlement_at": "2026-05-15T14:39:25Z",
+    "first_settlement_block": 345673,
+    "explorer_url": "https://testnet.ergoplatform.com/transactions/f697e4841dd9a0c689d0b83a311130b85a0cfbab123230a6c40284b44c4cafef",
+    "public_receipt_url": "https://www.ergoblockchain.org/r/sage/f697e4841dd9a0c689d0b83a311130b85a0cfbab123230a6c40284b44c4cafef",
+    "live_activity_feed": "https://www.ergoblockchain.org/api/sage/activity",
+    "notes": "Activity feed enumerates Sage's seller-wallet settlements live from the explorer; consumers (other agents, conformance runners, dashboards) poll it to verify rail health without trusting the operator's claim."
   },
   "conformance": {
     "level": "L0",
     "last_run_at": null,
     "result_uri": null,
-    "notes": "First conformance run pending — to be performed by accord-conformance --target https://www.ergoblockchain.org/api/sage/* once Sprint 3 ships."
+    "notes": "Manual end-to-end verified 2026-05-15 (see live_proof). Automated conformance run pending — accord-conformance v0 still in-flight; will target the four Sage HTTP endpoints + the live activity feed once the runner ships."
   },
   "operator": {
     "kind": "open-source-project",
