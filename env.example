# Database
DATABASE_URL="postgresql://username:password@localhost:5432/ergo_blog"
# Для разработки можно использовать SQLite:
# DATABASE_URL="file:./dev.db"

# Google Analytics
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Optional: для геолокации по IP
IPGEOLOCATION_API_KEY="your_api_key_here"

# Optional: для дополнительной аналитики
MIXPANEL_TOKEN="your_mixpanel_token"
PLAUSIBLE_DOMAIN="ergoblockchain.org"
OBSERVABILITY_TOKEN=""
INDEXNOW_TRIGGER_SECRET=""

# Blog CMS
BLOB_READ_WRITE_TOKEN=""
BLOG_ADMIN_TOKEN=""

# Developer services: guarded testnet faucet proxy
ERGO_TESTNET_FAUCET_ENABLED=false
ERGO_TESTNET_FAUCET_BACKEND_URL=""
ERGO_TESTNET_FAUCET_BACKEND_TOKEN=""
ERGO_TESTNET_FAUCET_AMOUNT_NANOERG=100000000
ERGO_TESTNET_FAUCET_TURNSTILE_SECRET=""
