{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "agents.ergoblockchain.org" }],
      "destination": "/agent-economy/live"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "agenthub.ergoblockchain.org" }],
      "destination": "/agent-economy/live"
    },
    {
      "source": "/live",
      "has": [{ "type": "host", "value": "agents.ergoblockchain.org" }],
      "destination": "/agent-economy/live"
    },
    {
      "source": "/live",
      "has": [{ "type": "host", "value": "agenthub.ergoblockchain.org" }],
      "destination": "/agent-economy/live"
    },
    {
      "source": "/sage-widget",
      "has": [{ "type": "host", "value": "agents.ergoblockchain.org" }],
      "destination": "/agent-economy/sage-widget"
    },
    {
      "source": "/sage-widget",
      "has": [{ "type": "host", "value": "agenthub.ergoblockchain.org" }],
      "destination": "/agent-economy/sage-widget"
    },
    {
      "source": "/quickstart",
      "has": [{ "type": "host", "value": "agents.ergoblockchain.org" }],
      "destination": "/build/agent-payments/quickstart"
    },
    {
      "source": "/quickstart",
      "has": [{ "type": "host", "value": "agenthub.ergoblockchain.org" }],
      "destination": "/build/agent-payments/quickstart"
    },
    {
      "source": "/playground",
      "has": [{ "type": "host", "value": "agents.ergoblockchain.org" }],
      "destination": "/build/playground"
    },
    {
      "source": "/playground",
      "has": [{ "type": "host", "value": "agenthub.ergoblockchain.org" }],
      "destination": "/build/playground"
    },
    {
      "source": "/services",
      "has": [{ "type": "host", "value": "agents.ergoblockchain.org" }],
      "destination": "/build/services"
    },
    {
      "source": "/services",
      "has": [{ "type": "host", "value": "agenthub.ergoblockchain.org" }],
      "destination": "/build/services"
    },
    {
      "source": "/api/live",
      "has": [{ "type": "host", "value": "agents.ergoblockchain.org" }],
      "destination": "/api/agent-economy/live"
    },
    {
      "source": "/api/live",
      "has": [{ "type": "host", "value": "agenthub.ergoblockchain.org" }],
      "destination": "/api/agent-economy/live"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "ergowatch.ergoblockchain.org" }],
      "destination": "/ergo-watch"
    }
  ],
  "redirects": []
}
